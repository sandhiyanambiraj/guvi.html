from pyspark.sql.types import *

catalog = "cat_ltm10877562"
schema = "schema_data_integration"
candidate_id = "vamshi"

snapshot_path = "/Volumes/cat_ltm10877562/schema_data_integration/ext_vol_vamshi/CDC01_Retail_Loyalty_Customer_CDC_snapshot.csv"
changes_path = "/Volumes/cat_ltm10877562/schema_data_integration/ext_vol_vamshi/CDC01_Retail_Loyalty_Customer_CDC_changes.csv"

target_table = catalog + "." + schema + ".cdc01_customers_" + candidate_id
events_table = catalog + "." + schema + ".cdc01_events_" + candidate_id

snapshot_schema = StructType([
    StructField("customer_id", StringType(), True),
    StructField("customer_name", StringType(), True),
    StructField("city", StringType(), True),
    StructField("loyalty_tier", StringType(), True),
    StructField("points_balance", IntegerType(), True),
    StructField("is_active", BooleanType(), True),
    StructField("last_updated", TimestampType(), True)
])

changes_schema = StructType([
    StructField("event_id", StringType(), True),
    StructField("customer_id", StringType(), True),
    StructField("customer_name", StringType(), True),
    StructField("city", StringType(), True),
    StructField("loyalty_tier", StringType(), True),
    StructField("points_balance", IntegerType(), True),
    StructField("is_active", BooleanType(), True),
    StructField("last_updated", TimestampType(), True),
    StructField("operation", StringType(), True)
])

snapshot_df = (
    spark.read.option("header", True)
    .schema(snapshot_schema)
    .csv(snapshot_path)
)

changes_df = (
    spark.read.option("header", True)
    .schema(changes_schema)
    .csv(changes_path)
)

print("Snapshot count:", snapshot_df.count())
print("Snapshot NULL points:", snapshot_df.filter("points_balance IS NULL").count())
print("Changes count:", changes_df.count())

changes_df.groupBy("operation").count().orderBy("operation").show()

display(snapshot_df)
display(changes_df)






from pyspark.sql.functions import col

# Replace NULL points_balance with integer 0
snapshot_clean_df = snapshot_df.fillna({"points_balance": 0})

# Create initial managed Delta table
# Use overwrite only for initial creation
(
    snapshot_clean_df.write
    .format("delta")
    .mode("overwrite")
    .saveAsTable(target_table)
)

print("Initial table:", target_table)

# Validate baseline
spark.sql(f"""
SELECT
    COUNT(*) AS records,
    COUNT(DISTINCT customer_id) AS unique_customers,
    SUM(CASE WHEN points_balance IS NULL THEN 1 ELSE 0 END) AS null_points,
    SUM(points_balance) AS total_points
FROM {target_table}
""").show()








# Create managed staging Delta table
(
    changes_df.write
    .format("delta")
    .mode("overwrite")
    .saveAsTable(events_table)
)

print("Staging table:", events_table)

# Validate CDC operations and event uniqueness
spark.sql(f"""
SELECT operation, COUNT(*) AS event_count
FROM {events_table}
GROUP BY operation
ORDER BY operation
""").show()

spark.sql(f"""
SELECT COUNT(*) AS total_events,
       COUNT(DISTINCT event_id) AS unique_events
FROM {events_table}
""").show()

# MERGE: delete, update, and insert
merge_sql = f"""
MERGE INTO {target_table} AS target
USING {events_table} AS source
ON target.customer_id = source.customer_id

WHEN MATCHED AND source.operation = 'D'
THEN DELETE

WHEN MATCHED AND source.operation = 'U'
THEN UPDATE SET
    target.customer_name = source.customer_name,
    target.city = source.city,
    target.loyalty_tier = source.loyalty_tier,
    target.points_balance = source.points_balance,
    target.is_active = source.is_active,
    target.last_updated = source.last_updated

WHEN NOT MATCHED AND source.operation = 'I'
THEN INSERT (
    customer_id, customer_name, city, loyalty_tier,
    points_balance, is_active, last_updated
)
VALUES (
    source.customer_id, source.customer_name, source.city,
    source.loyalty_tier, source.points_balance,
    source.is_active, source.last_updated
)
"""

# First MERGE
spark.sql(merge_sql)
print("First MERGE completed")

# Validate changed customers
spark.sql(f"""
SELECT customer_id, loyalty_tier, points_balance,
       is_active, last_updated
FROM {target_table}
WHERE customer_id IN ('C002','C004','C006','C013','C014')
ORDER BY customer_id
""").show(truncate=False)

# Second MERGE: test idempotency
spark.sql(merge_sql)
print("Second MERGE completed")

# Confirm final state after the second MERGE
spark.sql(f"""
SELECT
    COUNT(*) AS records,
    COUNT(DISTINCT customer_id) AS unique_customers,
    SUM(points_balance) AS total_points
FROM {target_table}
""").show()











