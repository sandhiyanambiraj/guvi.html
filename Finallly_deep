from pyspark.sql import SparkSession, DataFrame
from pyspark.sql import functions as F

def load_feedback_data(spark: SparkSession, path: str) -> DataFrame:
    """
    1. Load Feedback Data
    Loads feedback data from a CSV using header and schema inference.
    """
    # Use spark.read method with header=True and inferSchema=True
    return spark.read.csv(path, header=True, inferSchema=True)


def clean_missing_and_invalid_emails(df: DataFrame) -> DataFrame:
    """
    2. Clean Invalid Emails
    Removes rows with null, empty emails.
    """
    # Use .filter() to retain only emails that are not null and not empty after trimming
    return df.filter(
        (F.col("email").isNotNull()) & 
        (F.trim(F.col("email")) != "")
    )


def compute_rating_stats(df: DataFrame) -> dict:
    """
    3. Compute Rating Statistics
    Computes min, max, and average rating and returns as a dictionary.
    """
    # Change data type of rating column to integer and filter with isNotNull
    clean_df = df.withColumn("rating", F.col("rating").cast("integer")) \
                 .filter(F.col("rating").isNotNull())

    # Use agg() for min, max, avg
    stats_row = clean_df.agg(
        F.min("rating").alias("min_rating"),
        F.max("rating").alias("max_rating"),
        F.avg("rating").alias("avg_rating")
    ).collect()[0]

    # Return dictionary with appropriate keys as per expected output format
    return {
        "min_rating": stats_row["min_rating"],
        "max_rating": stats_row["max_rating"],
        "avg_rating": stats_row["avg_rating"]
    }


def count_ratings(df: DataFrame) -> int:
    """
    4. Count Ratings
    Counts the number of valid (non-null) ratings in the DataFrame.
    """
    # Use .filter method on column to count non-null ratings
    return df.filter(F.col("rating").isNotNull()).count()


def most_common_rating(df: DataFrame) -> int:
    """
    5. Most Common Rating
    Returns the most frequent rating. In case of a tie, returns the lower rating.
    """
    # Change data type of rating column to integer
    # Validate rating values are in range of 1-5 using .between(1,5)
    valid_df = df.withColumn("rating", F.col("rating").cast("integer")) \
                 .filter(F.col("rating").between(1, 5))

    # Sort dataframe on the basis of count implemented on rating column
    # Adding rating ascending as a secondary sort to handle ties (return lower rating in case of tie)
    sorted_counts = valid_df.groupBy("rating").count() \
                            .orderBy(F.col("count").desc(), F.col("rating").asc())

    # Return the first entry from rating column. Return 0 if empty.
    result = sorted_counts.take(1)
    
    if result:
        return result[0]["rating"]
    else:
        return 0
